<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
	
	<category>
	    <pattern>Spell *</pattern>
	    <template>
	        <lowercase><explode><star/></explode></lowercase>
	    </template>
    </category>
    
    <category>
	    <pattern>My go to place is *</pattern>
	    <template>
	        <formal><star/></formal> is a heavenly place to visit!
	    </template>
    </category>
    
    <category>
        <pattern>I ate *</pattern>
        <template>
          Was it tasty ?
            <learnf>
                <category>
                    <pattern>What did I eat</pattern>
                    <template>You just told me you ate <eval><star/></eval>
                    </template>
                </category>
            </learnf>
        </template>
    </category> 
</aiml>