<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
<category>
    <pattern># movie sites #</pattern>
        <template>
           Try one of the mentioned links to download the movie you want:
          <ol>
           <li> <link>
             <text>Katmovie</text>
             <url>https://katworld.net</url>
            </link> </li>
            <li> <link>
             <text>Vegamovies</text>
             <url>https://vega-ship.com</url>
            </link></li>
            <li> <link>
             <text>HDHub4u</text>
             <url>https://hdhub4u.bi</url>
            </link></li>
            <li> <link>
             <text>Mp4Movies</text>
             <url>https://mp4law.com</url>
            </link></li>
         </ol>
        </template>
</category>

<category>
   <pattern># download # movie #</pattern>
   <template><srai>movie sites</srai></template>
</category>

<category>
   <pattern># watch # movie # online #</pattern>
   <template><srai>movie sites</srai></template>
</category>

<category>
   <pattern># stream # movie #</pattern>
   <template><srai>movie sites</srai></template>
</category>


