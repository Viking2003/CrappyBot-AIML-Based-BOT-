<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
	<category>
	    <pattern>Show me a website #</pattern>
	   <template>
	        Check out GTA VI video game releasing on PS5/Xbox Series X|S on November 19, 2026.<break/>
	      <link>
	        <text>Click here for more!</text>
	        <url>https://www.rockstargames.com/VI</url>
	       </link>
	    </template>
    </category>
    
    
    <category>
        <pattern>How many days until GTA6</pattern>
        <template>
            <interval>
                <jformat>MMMMMMMM dd YYYY</jformat>
                <style>days</style>
                <from><date jformat="MMMMMMMM dd YYYY"/></from>
                <to>November 19, 2026</to>
            </interval> days to go.
        </template>
    </category>

    <category>
        <pattern>How many days until GTA VI</pattern>
        <template>
            <srai>How many days until GTA6</srai>
        </template>
    </category>
    
    <category>
        <pattern>How many days until GTAVI</pattern>
        <template>
            <srai>How many days until GTA6</srai>
        </template>
    </category>

     <category>
        <pattern>How many days until GTA 6</pattern>
        <template>
            <srai>How many days until GTA6</srai>
        </template>
    </category>

      <category>
        <pattern>How old are you</pattern>
        <template>
            <interval>
                <jformat>MMMMMMMM dd YYYY</jformat>
                <style>days</style>
                <from><bot name="birthdate"/></from>
                <to><date jformat="MMMMMMMM dd YYYY"/></to>
            </interval> days
        </template>
    </category>
    
    <category>
        <pattern>Talk to *</pattern>
        <template>I have asked to talk to <person2/></template>
    </category>
    
    <category>
        <pattern>What do you use</pattern>
        <template>I use <program/></template>
    </category>
</aiml>
