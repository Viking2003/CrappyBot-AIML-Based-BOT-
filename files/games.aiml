<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
	<category>
    <pattern>Storyline of *</pattern>
    <template>
        <think><set name="gamestory"><map name="games"><star/></map></set></think>
        <condition name="gamestory">
            <li value="unknown">Sorry, I don't have information about the storyline of "<star/>" game.</li>
            <li value="Uncharted">Kindly mention proper game name like Uncharted: The Lost Legacy or Uncharted: A Thief's End.</li>
            <li value="The Last of Us">Kindly mention The Last of Us Part I or The Last of Us Part II.</li>
            <li>Storyline: <get name="gamestory"/></li>
        </condition>
    </template>
</category>

<category>
    <pattern>What is the storyline of *</pattern>
    <template><srai>Storyline of <star/></srai></template>
</category>

<category>
    <pattern>Tell me about *</pattern>
    <template><srai>Storyline of <star/></srai></template>
</category>

<category>
   <that>Kindly mention proper game name like Uncharted: The Lost Legacy or Uncharted: A Thief's End</that>
    <pattern>*</pattern>
    <template><srai>Storyline of <star/></srai></template>
</category>

<category>
   <that>Kindly mention The Last of Us Part I or The Last of Us Part II</that>
    <pattern>*</pattern>
    <template><srai>Storyline of <star/></srai></template>
</category>

</aiml>