<?xml version="1.0" encoding="UTF-8"?>
<aiml>

     <category>
        <pattern>Hello #</pattern>
        <template>Hii, how can I help you today?</template>
    </category>
    
    <category>
        <pattern>Hii #</pattern>
        <template><srai>Hello</srai></template>
    </category>

   <category>
    <pattern>Search for *</pattern>
    <template>
        <think><set name="siteurl"><map name="sitemap"><star/></map></set></think>
        <condition name="siteurl">
            <li value="unknown">Sorry, I don't know a website for "<star/>".</li>
            <li><button><text>Open <star/></text><url><get name="siteurl"/></url></button></li>
        </condition>
    </template>
</category>
    
    <category>
        <pattern>What is * *</pattern>
        <template>I don't know what <person><star index="1"/></person> <star index="2"/> is.</template>
    </category>
    
    <category>
        <pattern>_ date</pattern>
        <template>It is <date locale="fr_FR"/></template>
    </category>
    
    <category>
        <pattern>I like *</pattern>
        <template>What do you like most about <denormalize><star/></denormalize></template>
    </category>
    
    <category>
        <pattern>Tell me your name #</pattern>
        <template>
            You can call me CrappyBot. I am a chatbot created by Vivek Yadav.
        </template>
    </category>

    <category>
        <pattern>What # your name #</pattern>
        <template>
            <srai>Tell me your name</srai>
        </template>
    </category>
    
     <category>
        <pattern>GTEST *</pattern>
        <template>
            <gender><star/></gender>
        </template>
    </category>
    
   <category>
    <pattern>Tell me about yourself</pattern>
      <template>
        I'm CrappyBot, a chatbot built by Vivek Yadav. I'm still learning and improving, but I can chat about
        a range of topics, answer questions, and give recommendations — games and animals included.
        Right now I know the most about game storylines and plots across various platforms.
        Ask me about one by saying "Tell me about (game name)" or "What is the storyline of (game name)". Try asking me 
        "movie sites" or "anime sites" and I will provide you with a list of websites to watch movies or anime online/download for free.
      </template>
   </category>
    
   <category>
     <pattern>How much # knowledge #</pattern>
     <template>I know <size/> items of knowledge.</template>
   </category>
    
    <category>
     <pattern>How much # learnt #</pattern>
     <template><srai>How much knowledge</srai></template>
    </category>

    <category>
     <pattern>How much # know #</pattern>
     <template><srai>How much knowledge</srai></template>
    </category>

    <category>
        <pattern>What is my ID</pattern>
        <template>
            I know you as <id/>
        </template>
    </category>
    
    <category>
        <pattern>What did I say</pattern>
        <template>You said <input index="2"/></template>
    </category>
    
    <category>
        <pattern>Before that</pattern>
        <template>You said <input index="4"/></template>
    </category>
    
    <category>
        <pattern>What did you say</pattern>
        <template>I said <response index="2"/></template>
    </category>

    <category>
        <pattern># created you #</pattern>
        <template>My creator is <bot name="father"/>!</template>
    </category>
    
    <category>
        <pattern># made you #</pattern>
        <template><srai>created you</srai></template>
    </category>

    <category>
        <pattern># your creator #</pattern>
        <template><srai>created you</srai></template>
    </category>

    <category>
        <pattern># your father #</pattern>
        <template><srai>created you</srai></template>
    </category>

    <category>
        <pattern>when # created #</pattern>
        <template>I was created by Vivek Yadav on 7th September 2026!</template>
    </category>

     <category>
        <pattern>when # made #</pattern>
        <template><srai>when created</srai></template>
    </category>
</aiml>

