<?xml version="1.0" encoding="UTF-8"?>
<aiml>

     <category>
        <pattern>Hello #</pattern>
        <template>Hii, how can I help you today?</template>
    </category>
    
    <category>
        <pattern>Hii #</pattern>
        <template><srai>Hello</srai></template>
    </category>

   <category>
    <pattern>Search for *</pattern>
    <template>
        <think><set name="siteurl"><map name="sitemap"><star/></map></set></think>
        <condition name="siteurl">
            <li value="unknown">Sorry, I don't know a website for "<star/>".</li>
            <li><button><text>Open <star/></text><url><get name="siteurl"/></url></button></li>
        </condition>
    </template>
</category>
    
    <category>
        <pattern>What is * *</pattern>
        <template>I don't know what <person><star index="1"/></person> <star index="2"/> is.</template>
    </category>
    
    <category>
        <pattern>_ date</pattern>
        <template>It is <date locale="fr_FR"/></template>
    </category>
    
    <category>
        <pattern>I like *</pattern>
        <template>What do you like most about <denormalize><star/></denormalize></template>
    </category>
    
    <category>
        <pattern>Tell me *</pattern>
        <template>
            first = <first><star/></first><break/>
            rest = <rest><star/></rest>
        </template>
    </category>
    
     <category>
        <pattern>GTEST *</pattern>
        <template>
            <gender><star/></gender>
        </template>
    </category>
    
    <category>
        <pattern>test2 *</pattern>
        <template>
            <sentence><lowercase><star/></lowercase></sentence>
        </template>
    </category>
    
    <category>
        <pattern>How much do you know</pattern>
        <template>I know <map name="predecessor"><size/></map> items of knowledge.</template>
    </category>
    
    <category>
        <pattern>What is my ID</pattern>
        <template>
            I know you as <id/>
        </template>
    </category>
    
    <category>
        <pattern>What did I say</pattern>
        <template>You said <input index="2"/></template>
    </category>
    
    <category>
        <pattern>Before that</pattern>
        <template>You said <input index="4"/></template>
    </category>
    
    <category>
        <pattern>What did you say</pattern>
        <template>I said <response index="2"/></template>
    </category>

    <category>
        <pattern># created you #</pattern>
        <template>My creator is Vivek Yadav!</template>
    </category>
    
    <category>
        <pattern># made you #</pattern>
        <template><srai>created you</srai></template>
    </category>

    <category>
        <pattern># your creator #</pattern>
        <template><srai>created you</srai></template>
    </category>

    <category>
        <pattern># your father #</pattern>
        <template><srai>created you</srai></template>
    </category>

    <category>
        <pattern>when # created #</pattern>
        <template>I was created by Vivek Yadav on 7th September 2026!</template>
    </category>
</aiml>

